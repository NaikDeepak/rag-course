# Copy this file to .env and fill in at least one provider key:
# cp .env.example .env

# Option 1: Google Gemini (used in Course Final Project & supported across all lessons)
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Option 2: OpenAI (used in early Course lessons)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Provider selection: "auto" | "gemini" | "openai" | "fake"
RAG_PROVIDER=auto
